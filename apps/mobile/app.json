{
  "expo": {
    "name": "Rehab",
    "slug": "rehab",
    "version": "1.0.0",
    "scheme": "rehab",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rehab.trial",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to your rehab server on your local network during development."
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F7F3"
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Rehab"
    },
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png"
  }
}
